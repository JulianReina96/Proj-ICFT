@model FormularioViewModel;


<script type="text/javascript">
    $(document).ready(function () {
        let dadosMapeados = [];
        document.getElementById('btnObterICT').setAttribute('disabled', 'disabled');
        $('#categorias').change(function () {
            var categoriaId = $(this).val();

            $.ajax({
                url: '@Url.Action("ObterSubcategorias", "Home")', // Substitua por sua action
                data: { categoriaId: categoriaId },
                success: function (data) {
                    $('#subcategorias').empty().append('<option value="">Selecione uma subcategoria</option>');
                    $.each(data, function (i, subcategoria) {
                        $('#subcategorias').append($('<option>').val(subcategoria.id).text(subcategoria.name));
                    });
                    $('#subcategorias').show();
                }
            });
        });

        const salvarBtn = document.getElementById('salvar');
        const exportarBtn = document.getElementById('btnObterICT');
        const gerarPdfBtn = document.getElementById('btnGerarPDF');
        const cardsDiv = document.getElementById('cards');

        salvarBtn.addEventListener('click', () => {
            if (!validarCampos()) {
                return;
            }
            // Obtém os valores dos campos
            const remedio = document.getElementById('remedio').value;
            const categorias = document.getElementById('categorias').options[document.getElementById('categorias').selectedIndex].text;
            const frequencia = document.getElementById('frequencia').options[document.getElementById('frequencia').selectedIndex].text;
            const subcategoria = document.getElementById('subcategorias').options[document.getElementById('subcategorias').selectedIndex].text;
            const instrucoesAdicionais = Array.from(document.querySelectorAll('input[name="InstrucoesAdicionais"]:checked')).map(checkbox => checkbox.previousElementSibling.textContent);


            // Cria um novo card
            const newCard = document.createElement('div');
            id = dadosMapeados.length + 1;
            newCard.id = 'card' + (dadosMapeados.length + 1);
            newCard.classList.add('card'); // Adiciona uma classe para estilizar
            newCard.innerHTML = `
                                        <h2>Informações do Medicamento</h2>
                            <h4> <b>Medicamento:</b> <strong>${remedio}</strong></h4>
                                        <p><b>Categoria:</b> ${categorias}</p>
                                       <p> <b>Tipo:</b> ${subcategoria}</p>
                                <p><b>Frequencia:</b> ${frequencia}</p>
                                   <p><b>Instruções Adicionais:</b> ${instrucoesAdicionais.join(', ')}</p>

                                `;




            const quebraLinha = document.createElement('br');
            // Adiciona o card à div de cards
            cardsDiv.appendChild(newCard);
            cardsDiv.appendChild(quebraLinha);
            const cards = document.querySelectorAll('.card');

            // Mapeia os cards (pode ser feito a cada clique ou em outro momento)


            const dadosCard = {
                categoria: document.getElementById('categorias').options[document.getElementById('categorias').selectedIndex].value,
                subcategoria: document.getElementById('subcategorias').options[document.getElementById('subcategorias').selectedIndex].value,
                frequencia: document.getElementById('frequencia').options[document.getElementById('frequencia').selectedIndex].value,
                instrucoesAdicionais: Array.from(document.querySelectorAll('input[name="InstrucoesAdicionais"]:checked')).map(checkbox => checkbox.value)


            };
            dadosMapeados.push(dadosCard);


            // Reseta os elementos HTML para seus valores padrão
            document.getElementById('categorias').selectedIndex = 0;
            document.getElementById('subcategorias').innerHTML = '<option value="">Selecione uma subcategoria</option>';
            document.getElementById('frequencia').selectedIndex = 0;
            document.querySelectorAll('input[name="InstrucoesAdicionais"]').forEach(checkbox => checkbox.checked = false);


            document.getElementById('remedio').value = '';
            console.log(dadosMapeados);

            document.getElementById('btnObterICT').removeAttribute("disabled");
            document.getElementById('btnGerarPDF').removeAttribute("hidden");

        });

        exportarBtn.addEventListener('click', () => {

            if (document.getElementById("nomePaciente").value === '') {
                Swal.fire({
                    icon: 'error',
                    title: 'Nome do paciente não informado',
                    text: 'Informe o nome do paciente para prosseguir'
                });
                return;
            }

            exportExcel(dadosMapeados);


        });

        gerarPdfBtn.addEventListener('click', () => {
            gerarPDF();
        });

        // Exibe os dados mapeados no console
    });


    function validarCampos() {


        const remedio = document.getElementById('remedio').value;
        const categorias = document.getElementById('categorias').value;
        const subcategorias = document.getElementById('subcategorias').value;
        const frequencia = document.getElementById('frequencia').value;



        let mensagemErro = '';


        if (remedio === '') {
            mensagemErro += '<p>O campo <b>"Nome do Remédio"</b> precisa ser preenchido.</p>';
        }
        if (categorias === '') {
            mensagemErro += '<p>O campo <b>"Categoria"</b> precisa ser preenchido.</p>';
        }
        if (subcategorias === '') {
            mensagemErro += '<p>O campo <b>"Subcategoria"</b> precisa ser preenchido.</p>';
        }
        if (frequencia === '') {
            mensagemErro += '<p>O campo <b>"Frequência"</b> precisa ser preenchido.</p>';
        }

        if (mensagemErro !== '') {
            Swal.fire({
                icon: 'error',
                title: 'Campos obrigatórios',
                html: mensagemErro
            });
            return false;
        }
        return true;
    }


    function exportExcel(dadosMapeados) {
        const dadosExportacao = { nome: document.getElementById('nomePaciente').value, medicamentos: dadosMapeados };
        console.log(JSON.stringify(dadosExportacao));


        $.ajax({
            url: '@Url.Action("ExportarDados", "Home")', // Substitua por sua action
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dadosExportacao),
            success: function (response) {

                // downloadExcel(response);
                console.log(response);

                Swal.fire({
                    icon: 'success',
                    title: 'Dados calculados com sucesso!',
                    text: "Valor Calculado: " + response,
                    allowOutsideClick: false,
                    allowEscapeKey: false,

                }).then((result) => {
                    if (result.isConfirmed) {
                        location.reload(); // Substitua pela URL desejada
                    }
                });

            },
            error: function (xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erro ao exportar dados',
                    text: xhr.responseText
                });
            }
        });
    }

    function downloadExcel(data) {



        var nome = document.getElementById('nomePaciente').value;

        nome = nome.replace(/ /g, '_');
        var row = [];
        row.push(data);


        const wb = XLSX.utils.json_to_sheet(row);
        const ws = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(ws, wb, 'Dados');
        XLSX.writeFile(ws, 'IC-' + nome + '.xlsx');
    }

    function gerarPDF() {
        const nomePaciente = document.getElementById('nomePaciente').value;
        const cards = document.querySelectorAll('.card');
        let conteudo = `<h1>Paciente: ${nomePaciente}</h1><br>`;

        cards.forEach(card => {
            conteudo += card.outerHTML;
        });

        const opt = {
            margin: 1,
            filename: 'Receita-' + nomePaciente.replace(/ /g, '_') + '.pdf',
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
        };

        html2pdf().from(conteudo).set(opt).save();
    }

    function remover(id) {
        const card = document.getElementById('card' + id);
        card.remove();

        if (document.querySelectorAll('.card').length === 0) {
            document.getElementById('btnObterICT').setAttribute('disabled', 'disabled');
            document.getElementById('btnGerarPDF').setAttribute('hidden', 'hidden');
        }

        dadosMapeados[id - 1].remove();
    }


</script>








<div class="formbold-main-wrapper">
    <!-- Author: FormBold Team -->
    <!-- Learn More: https://formbold.com -->
    <div class="formbold-form-wrapper">

        <form action="https://formbold.com/s/FORM_ID" method="POST">
            <div class="formbold-mb-6">
                <h3>Informe a receita e o nome do paciente</h3>
                <br />

                <label id="paciente" placeholder="Nome do Paciente" class="formbold-form-label">Nome do Paciente</label>
                <input id="nomePaciente" class="formbold-form-input">



                <label for="remedioLbl" class="formbold-form-label">Nome do Remedio</label>
                <input id="remedio" type="text" class="formbold-form-input">
                <div class="formbold-radio-flex">
                    <div class="formbold-radio-group">
                        <select class="form-select" name="categorias" id="categorias">
                            <option value="" disabled selected>Informe a forma de dosagem:</option>
                            @foreach (var option in Model.categorias)



                            {
                                <option value="@option.Id">@option.Name</option>
                            }
                        </select>

                        <select class="form-select" name="Subcategorias" id="subcategorias">
                            <option value="">Selecione uma subcategoria</option>
                        </select>
                    </div>
                    <br />
                    <div class="formbold-radio-group">

                        <select class="form-select" required name="Frequencia" id="frequencia">
                            <option value="" disabled selected>Informe a frequencia de dosagem:</option>
                            @foreach (var option in Model.frequencias)



                            {
                                <option value="@option.Id">@option.Name</option>
                            }
                        </select>
                        <span class="formbold-radio-checkmark"></span>

                    </div>
                    <br />


                    <div>
                        <strong><label>Informe as instruções adicionais:</label></strong>
                        <h6 style="color:red; font-size:0.7rem !important;">Não obrigatorio*</h6>
                        <br /> <br />
                        @foreach (var option in Model.instrucoes)
                        {
                            <div>
                                <label for="instrucoesAdicionais_@option.id">@option.name</label>
                                <input type="checkbox" class="checkboxPage" id="instrucoesAdicionais_@option.id" name="InstrucoesAdicionais" value="@option.id">
                               
                            </div>
                        }
                    </div>



                    <button id="salvar" class="btn btn-primary" type="button">Adicionar medicamento</button>
                    <div id="cards"></div>


                </div>
            </div>
            <button type="button" disabled class="btn btn-success" id="btnObterICT">Obter ICT</button>
            <button type="button" hidden class="btn btn-secondary" id="btnGerarPDF">Gerar PDF</button>
        </form>
    </div>
    @await Html.PartialAsync("~/Views/Alertas/_Alertas.cshtml", Model.Alerta)
</div>
<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
    }

    .formbold-main-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px;
    }

    .formbold-form-wrapper {
        margin: 0 auto;
        max-width: 570px;
        width: 100%;
        background: white;
        padding: 40px;
    }

    .formbold-img {
        display: block;
        margin: 0 auto 40px;
    }

    .formbold-form-input {
        width: 100%;
        padding: 13px 22px;
        border-radius: 5px;
        border: 1px solid #dde3ec;
        background: #ffffff;
        font-weight: 500;
        font-size: 16px;
        color: #536387;
        outline: none;
        resize: none;
    }

        .formbold-form-input:focus {
            border-color: #6a64f1;
            box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.05);
        }

    .formbold-form-label {
        color: #07074d;
        font-weight: 500;
        font-size: 14px;
        line-height: 24px;
        display: block;
        margin-bottom: 20px;
    }

        .formbold-form-label span {
            color: #536387;
            font-size: 12px;
            line-height: 18px;
            display: inline-block;
        }

    .formbold-mb-3 {
        margin-bottom: 15px;
    }

    .formbold-mb-6 {
        margin-bottom: 30px;
    }

    .formbold-radio-flex {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .checkboxPage{
        width:25px !important;
    }

    .formbold-radio-label {
        font-size: 14px;
        line-height: 24px;
        color: #07074d;
        position: relative;
        padding-left: 25px;
        cursor: pointer;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }

    .formbold-input-radio {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .formbold-radio-checkmark {
        position: absolute;
        top: -1px;
        left: 0;
        height: 18px;
        width: 18px;
        background-color: #ffffff;
        border: 1px solid #dde3ec;
        border-radius: 50%;
    }

    .formbold-radio-label
    .formbold-input-radio:checked ~ .formbold-radio-checkmark {
        background-color: #6a64f1;
    }

    .formbold-radio-checkmark:after {
        content: '';
        position: absolute;
        display: none;
    }

    .formbold-radio-label
    .formbold-input-radio:checked ~ .formbold-radio-checkmark:after {
        display: block;
    }

    .formbold-radio-label .formbold-radio-checkmark:after {
        top: 50%;
        left: 50%;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #ffffff;
        transform: translate(-50%, -50%);
    }

    .formbold-btn {
        text-align: center;
        width: 100%;
        font-size: 16px;
        border-radius: 5px;
        padding: 14px 25px;
        border: none;
        font-weight: 500;
        color: white;
        cursor: pointer;
        margin-top: 25px;
    }

        .formbold-btn:hover {
            box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.05);
        }
</style>
