@using Proj_ICFT.Models.DTO
@model AdministradorDTO
@{
    ViewData["Title"] = "Forgot";
}
<body>
    <div style="margin-top: 85px">
        <div class="container-sm containerProperty  w-100 p-3 border ">

            <center><h2 style="color:white"> Recuperação de senha</h2></center>
            <center><img src="~/img/ictLogo.png" width="200px" class="logoLogin"></center>

            <div class="col-md-6 offset-md-3">
                <label asp-for="Email"></label>
                <div class="col-md-12">
                    <input asp-for="Email" class="form-control" id="email" aria-describedby="login" placeholder=" Insira o Email para redefinição de senha" required>
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <center>
                        <button type="submit" style="margin: 15px" class="btn btn-primary btn-lg btn-block" onclick="forgot()"> Enviar email de recuperação</button>
                    </center>
                </div>
            </div>
        </div>
    </div>
</body>

<script src="https://www.gstatic.com/firebasejs/7.5.0/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/6.2.0/firebase-auth.js"></script>
<script>

    const firebaseConfig = {
        apiKey: "AIzaSyCY6ZiTuU3iDVMe37SK2p1oWCCoe7ltEV4",
        authDomain: "web-ict-56392.firebaseapp.com",
        projectId: "web-ict-56392",
        storageBucket: "web-ict-56392.firebasestorage.app",
        messagingSenderId: "140115829710",
        appId: "1:140115829710:web:e65ce11de8e99c7fbdc19f"
    };

    // Initialize Firebase
    firebase.initializeApp(firebaseConfig);
    var provider = new firebase.auth.GoogleAuthProvider();
    provider.addScope('https://www.googleapis.com/auth/contacts.readonly');



    function forgot() {
        var email = document.getElementById("email");
        firebase.auth().sendPasswordResetEmail(email.value)
            .then(() => {
                console.log(email.value);
                Swal.fire({
                    title: 'Email enviado com sucesso',
                    icon: 'success',
                    confirmButtonText: 'Ok'
                })

            })
            .catch((error) => {
                console.log(error);
                Swal.fire({
                    title: 'Não foi possivel concluir a sua solicitação.<br> Verifique seus dados e tente novamente em alguns instantes',
                    icon: 'error',
                    confirmButtonText: 'Ok'
                })
                /*var errorCode = error.code;
                var errorMessage = error.message;
                /*/
            });
    }

</script>