
@using Proj_ICFT.Models.DTO
@model AdministradorDTO
@{
    ViewData["Title"] = "Login";
}

<body>
    <div style="margin-top: 85px">
        <div class="container-sm containerProperty  w-100 p-3 border ">
            @using (Html.BeginForm("Signin2", "Account", FormMethod.Post)) //alterar para caminho da controller
            {
                <center><h1 style="color:white">Acesso ao Portal</h1></center>
                <center><img src="~/img/ictLogo.png" width="200px" class="logoLogin"></center>


                <div class="col-md-6 offset-md-3">
                    <label asp-for="Email"></label>
                    <div class="col-md-12">
                        <input asp-for="Email" class="form-control" id="login" aria-describedby="login" placeholder=" Insira o login" required>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6 offset-md-3">
                    <label asp-for="Senha"></label>
                    <div class="col-md-12">
                        <input asp-for="Senha" type="password" class="form-control" id="senha" placeholder="Senha" required>
                        <span asp-validation-for="Senha" class="text-danger"></span>

                    </div>
                </div>
                <center>
                    <button type="submit" id="btnLogin" class="btn btn-primary btn-lg btn-block" style="width: 200px; margin: 15px">Login</button>
                </center>

            }
            @*<partial name="~/Views/Alertas/_Alertas.cshtml" for="Alertas" view-data="ViewData"/>*@

            @await Html.PartialAsync(Alerta.ALERTAS)
            <form action="~/Account/ForgotPassword">
                <center>
                    <button type="submit" id="btnForgot" class="btn btn-primary btn-lg btn-block" style="width: 150px;height: 30px;font-size: small;line-height: 0px;">Esqueci a senha</button>
                </center>
            </form>

        </div>

        <!--Redirecionamento pela url local, alterar ao final do projeto-->


        <button id="btnLoginGoogle" onclick="login()" class="btn btn-primary btn-lg btn-block col-md-6 offset-md-3" hidden>Google</button>

